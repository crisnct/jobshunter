@startuml
left to right direction
skinparam componentStyle rectangle

package "Hunting Layer" {
    component GenericJobHunting as GJH
    component AiConversationJobHunting as ACJH
}

package "AiJobsClient API" {
    interface AiJobsClient
}

package "Client Implementations" {
    component GPT as "GptV1JobSearchImpl\n(JobsClientGPT)"
    component GROK as "GrokV1JobSearchImpl\n(JobsClientGROK)"
    component GEMINI as "GeminiV1JobSearchImpl\n(JobsClientGemini)"
    component SERP as "SerpClientImpl\n(JobsClientSerp)"
}

package "Test Doubles" {
    component FakeGPT as "FakeGptClient"
    component FakeGROK as "FakeGrokClient"
    component FakeGEMINI as "FakeGeminiClient"
    component FakeSERP as "FakeSerpClient"
}

package "External Providers" {
    component OpenAI as "OpenAI Responses API"
    component XAI as "xAI Grok API"
    component Gemini as "Google Gemini API"
    component SerpAPI as "SerpAPI Google Jobs"
}

GJH --> AiJobsClient : searchJobs / searchCompanies
ACJH --> AiJobsClient : searchJobs / searchCompanies

AiJobsClient <.. GPT
AiJobsClient <.. GROK
AiJobsClient <.. GEMINI
AiJobsClient <.. SERP

AiJobsClient <.. FakeGPT
AiJobsClient <.. FakeGROK
AiJobsClient <.. FakeGEMINI
AiJobsClient <.. FakeSERP

GPT --> OpenAI : REST + tools
GROK --> XAI : REST + deep search
GEMINI --> Gemini : REST + Google Search tool
SERP --> SerpAPI : HTTPS queries

FakeGPT ..> OpenAI : none (stub)
FakeGROK ..> XAI : none (stub)
FakeGEMINI ..> Gemini : none (stub)
FakeSERP ..> SerpAPI : none (stub)
@enduml
