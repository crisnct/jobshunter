<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">
  <appender class="ch.qos.logback.core.ConsoleAppender" name="CONSOLE">
    <encoder>
      <pattern>${INFO_PATTERN}</pattern>
    </encoder>
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>INFO</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
  </appender>

  <!-- Patterns for different log levels -->
  <appender class="ch.qos.logback.core.ConsoleAppender" name="CONSOLE_ERROR">
    <encoder>
      <pattern>${ERROR_PATTERN}</pattern>
    </encoder>
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>ERROR</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
    <target>System.err</target>
  </appender>
  <appender class="ch.qos.logback.core.ConsoleAppender" name="CONSOLE_WARN">
    <encoder>
      <pattern>${WARN_PATTERN}</pattern>
    </encoder>
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>WARN</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
  </appender>
  <appender class="ch.qos.logback.core.ConsoleAppender" name="CONSOLE_DEBUG">
    <encoder>
      <pattern>${DEBUG_PATTERN}</pattern>
    </encoder>
    <filter class="ch.qos.logback.classic.filter.LevelFilter">
      <level>DEBUG</level>
      <onMatch>ACCEPT</onMatch>
      <onMismatch>DENY</onMismatch>
    </filter>
  </appender>
  <appender class="ch.qos.logback.core.rolling.RollingFileAppender" name="FILE">
    <encoder>
      <pattern>${FILE_PATTERN}</pattern>
    </encoder>
    <file>${LOG_DIR}/application.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/application-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>20</maxHistory>
    </rollingPolicy>
  </appender>
  <appender class="ch.qos.logback.core.rolling.RollingFileAppender" name="FILE_ERROR">
    <encoder>
      <pattern>${FILE_PATTERN}</pattern>
    </encoder>
    <file>${LOG_DIR}/error.log</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>30</maxHistory>
    </rollingPolicy>
  </appender>

  <!-- Generic pattern for file logging -->
  <appender class="ch.qos.logback.classic.AsyncAppender" name="ASYNC_FILE">
    <appender-ref ref="FILE"/>
    <discardingThreshold>0</discardingThreshold>
    <queueSize>512</queueSize>
  </appender>

  <!-- Console Appender with different patterns per level -->
  <logger level="WARN" name="org.springframework"/>

  <!-- Error-specific console appender -->
  <logger level="INFO" name="org.springframework.boot.autoconfigure.logging"/>

  <!-- Warn-specific console appender -->
  <logger level="INFO" name="io.github.resilience4j"/>

  <!-- Debug-specific console appender -->
  <logger level="DEBUG" name="com.jobshunter"/>

  <!-- File Appender for all logs -->
  <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

  <!-- Separate file for errors only -->
  <property name="ERROR_PATTERN"
    value="%d{ISO8601} ❌ ERROR [%thread] %logger{36}.%M:%line - %msg%n"/>

  <!-- Async appender for better performance -->
  <property name="WARN_PATTERN"
    value="%d{ISO8601} ⚠️  WARN [%thread] %logger{36}.%M:%line - %msg%n"/>

  <!-- Root logger configuration -->
  <property name="INFO_PATTERN"
    value="%d{ISO8601} ✅ INFO  [%thread] %logger{36}.%M:%line - %msg%n"/>

  <!-- Spring Framework logging (reduce noise) -->
  <property name="DEBUG_PATTERN"
    value="%d{ISO8601} 🔧 DEBUG [%thread] %logger{36}.%M:%line - %msg%n"/>
  <property name="TRACE_PATTERN"
    value="%d{ISO8601} 🔍 TRACE [%thread] %logger{36}.%M:%line - %msg%n"/>

  <!-- Resilience4j logging -->
  <property name="FILE_PATTERN"
    value="%d{ISO8601} %-5level [%thread] %logger{36}.%M:%line - %msg%n"/>

  <!-- Your application logging -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="CONSOLE_WARN"/>
    <appender-ref ref="CONSOLE_ERROR"/>
    <appender-ref ref="CONSOLE_DEBUG"/>
    <appender-ref ref="ASYNC_FILE"/>
    <appender-ref ref="FILE_ERROR"/>
  </root>
</configuration>