<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="51-create-user-remote-cv-table" author="assistant">
        <comment>Create user_remote_cv table to store remote file information for CVs across different providers</comment>
        <createTable tableName="user_remote_cv">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_user_remote_cv"/>
            </column>
            <column name="user_cv_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="VARCHAR(25)">
                <constraints nullable="false"/>
            </column>
            <column name="file_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="filename" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="expire_time" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_user_remote_cv_user_cv"
                                 baseTableName="user_remote_cv"
                                 baseColumnNames="user_cv_id"
                                 referencedTableName="user_cv"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addUniqueConstraint tableName="user_remote_cv"
                             columnNames="user_cv_id, provider"
                             constraintName="uc_user_remote_cv_cv_provider"/>

        <createIndex tableName="user_remote_cv" indexName="idx_user_remote_cv_user_cv">
            <column name="user_cv_id"/>
        </createIndex>

        <createIndex tableName="user_remote_cv" indexName="idx_user_remote_cv_provider">
            <column name="provider"/>
        </createIndex>

        <createIndex tableName="user_remote_cv" indexName="idx_user_remote_cv_expire_time">
            <column name="expire_time"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
