<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

  <changeSet id="2026-02-06-create-user-oauth-providers-table" author="codex">
    <createTable tableName="user_oauth_providers">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="user_id" type="BIGINT">
        <constraints nullable="false"
                     foreignKeyName="fk_oauth_provider_user"
                     references="users(id)"/>
      </column>
      <column name="provider" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>
      <column name="provider_id" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="provider_email" type="VARCHAR(255)"/>
      <column name="created_at" type="DATETIME(3)">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addUniqueConstraint tableName="user_oauth_providers"
                         columnNames="provider, provider_id"
                         constraintName="uk_oauth_provider_id"/>

    <createIndex tableName="user_oauth_providers" indexName="idx_oauth_user_id">
      <column name="user_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
