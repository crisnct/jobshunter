<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

  <changeSet id="2026-02-03-set-job-order-notified-to-true" author="assistant">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="job_order"/>
      <columnExists tableName="job_order" columnName="notified"/>
    </preConditions>
    <comment>Set notified column to 1 (true) for all entries in job_order table</comment>
    <sql>
      UPDATE job_order SET notified = 1;
    </sql>
  </changeSet>

  <changeSet id="2026-02-03-add-score-column-to-user-jobs" author="assistant">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="user_jobs"/>
      <not>
        <columnExists tableName="user_jobs" columnName="score"/>
      </not>
    </preConditions>
    <comment>Add score column to user_jobs table</comment>
    <addColumn tableName="user_jobs">
      <column name="score" type="INT"/>
    </addColumn>
  </changeSet>

  <changeSet id="2026-02-03-add-location-columns-to-user-sessions" author="assistant">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="user_sessions"/>
    </preConditions>
    <comment>Add location-related columns to user_sessions table</comment>
    <addColumn tableName="user_sessions">
      <column name="city" type="TEXT"/>
      <column name="region" type="TEXT"/>
      <column name="country" type="TEXT"/>
      <column name="loc" type="TEXT"/>
      <column name="org" type="TEXT"/>
      <column name="timezone" type="TEXT"/>
    </addColumn>
  </changeSet>

</databaseChangeLog>
