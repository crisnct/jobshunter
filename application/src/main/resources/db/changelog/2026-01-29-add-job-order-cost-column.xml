<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

  <changeSet id="2026-01-29-add-job-order-cost-column" author="codex">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="job_order"/>
    </preConditions>
    <comment>Add cost column to job_order for accumulating AI request costs per order</comment>
    <addColumn tableName="job_order">
      <column name="cost" type="DOUBLE"/>
    </addColumn>
  </changeSet>

</databaseChangeLog>
