<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

  <changeSet id="2026-02-07-drop-prompts-jobs-table" author="codex">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="prompts_jobs"/>
    </preConditions>
    <comment>Drop prompts_jobs junction table — relationship tracked via prompt_id FK on user_jobs</comment>
    <dropTable tableName="prompts_jobs" cascadeConstraints="true"/>
  </changeSet>

</databaseChangeLog>
