<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="1-create-auth-tables" author="codex">
        <createTable tableName="roles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_roles"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_role_name"/>
            </column>
        </createTable>

        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_users"/>
            </column>
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_user_username"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_user_email"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_number" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="email_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="verification_token" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint tableName="users"
                             columnNames="verification_token"
                             constraintName="uc_user_verification_token"/>

        <createTable tableName="user_roles">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_roles"
                       columnNames="user_id, role_id"
                       constraintName="pk_user_roles"/>
        <addForeignKeyConstraint constraintName="fk_user_roles_user"
                                 baseTableName="user_roles"
                                 baseColumnNames="user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint constraintName="fk_user_roles_role"
                                 baseTableName="user_roles"
                                 baseColumnNames="role_id"
                                 referencedTableName="roles"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <createIndex tableName="user_roles" indexName="idx_user_roles_role">
            <column name="role_id"/>
        </createIndex>

        <createTable tableName="user_jobs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_user_jobs"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="job_url" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_user_jobs_user"
                                 baseTableName="user_jobs"
                                 baseColumnNames="user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addUniqueConstraint tableName="user_jobs"
                             columnNames="user_id, job_url"
                             constraintName="uc_user_jobs_user_url"/>
        <createIndex tableName="user_jobs" indexName="idx_user_jobs_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="2-seed-role-user" author="codex">
        <insert tableName="roles">
            <column name="id" valueNumeric="1"/>
            <column name="name" value="USER"/>
        </insert>
    </changeSet>

    <changeSet id="3-add-user-cv-file-id" author="codex">
        <addColumn tableName="users">
            <column name="cv_file_id" type="VARCHAR(255)"/>
        </addColumn>
        <createIndex tableName="users" indexName="idx_users_cv_file_id">
            <column name="cv_file_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="4-add-user-job-fields" author="Cristian Tone">
        <addColumn tableName="users">
            <column name="last_jobs" type="TIMESTAMP"/>
            <column name="time_interval" type="INT"/>
            <column name="prompt" type="text"/>
        </addColumn>
    </changeSet>

    <changeSet id="5-add-user-notifications" author="codex">
        <addColumn tableName="users">
            <column name="notify_whatsapp" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="notify_email" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="6-backfill-user-notifications" author="codex">
        <update tableName="users">
            <column name="notify_whatsapp" valueBoolean="false"/>
            <column name="notify_email" valueBoolean="false"/>
        </update>
    </changeSet>

    <changeSet id="7-seed-role-admin" author="codex">
        <insert tableName="roles">
            <column name="id" valueNumeric="2"/>
            <column name="name" value="ADMIN"/>
        </insert>
    </changeSet>

    <changeSet id="9-default-last-jobs-timestamp" author="codex">
        <dropDefaultValue tableName="users" columnName="last_jobs"/>
        <update tableName="users">
            <column name="last_jobs" valueDate="2025-01-01T00:00:00"/>
            <where>last_jobs = 0</where>
        </update>
        <addDefaultValue tableName="users"
                         columnName="last_jobs"
                         defaultValueDate="2025-01-01T00:00:00"/>
    </changeSet>

    <changeSet id="10-seed-role-test" author="codex">
        <insert tableName="roles">
            <column name="id" valueNumeric="3"/>
            <column name="name" value="TEST"/>
        </insert>
    </changeSet>

    <changeSet id="11-add-approved-to-users" author="Cristian Tone">
        <addColumn tableName="users">
            <column name="approved" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="12-add-serp-api-request-to-users" author="Cristian Tone">
        <addColumn tableName="users">
            <column name="serp_api_request" type="text">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="13-add-jwt-token-to-users" author="codex">
        <addColumn tableName="users">
            <column name="jwt_token" type="text"/>
        </addColumn>
    </changeSet>

    <changeSet id="14-create-user-prompts" author="codex">
        <createTable tableName="user_prompts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_user_prompts"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="prompt" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="engine" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="jobs_found" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_user_prompts_user"
                                 baseTableName="user_prompts"
                                 baseColumnNames="user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <createIndex tableName="user_prompts" indexName="idx_user_prompts_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="15-migrate-user-prompts" author="codex">
        <sql>
            INSERT INTO user_prompts (user_id, prompt, engine, jobs_found)
            SELECT id, prompt, 'GPT', 0
            FROM users
            WHERE prompt IS NOT NULL AND TRIM(prompt) &lt;&gt; '';
        </sql>
        <sql>
            INSERT INTO user_prompts (user_id, prompt, engine, jobs_found)
            SELECT id, serp_api_request, 'SERP', 0
            FROM users
            WHERE serp_api_request IS NOT NULL AND TRIM(serp_api_request) &lt;&gt; '';
        </sql>
    </changeSet>

    <changeSet id="16-drop-legacy-prompts-columns" author="codex">
        <dropColumn tableName="users" columnName="prompt"/>
        <dropColumn tableName="users" columnName="serp_api_request"/>
    </changeSet>

    <changeSet id="17-rename-gpt-to-gpt4-in-user-prompts" author="codex">
        <update tableName="user_prompts">
            <column name="engine" value="GPT4"/>
            <where>engine = 'GPT'</where>
        </update>
    </changeSet>

    <changeSet id="18-duplicate-gpt4-to-gpt5-user-prompts" author="codex">
        <sql>
            INSERT INTO user_prompts (user_id, prompt, engine, jobs_found)
            SELECT user_id, prompt, 'GPT5', jobs_found
            FROM user_prompts
            WHERE engine = 'GPT4';
        </sql>
    </changeSet>

    <changeSet id="19-create-user-cv-table" author="codex">
        <createTable tableName="user_cv">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_user_cv"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="cv" type="MEDIUMBLOB">
                <constraints nullable="false"/>
            </column>
            <column name="gpt_file_id" type="VARCHAR(255)"/>
            <column name="gemini_file_id" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_user_cv_user"
                                 baseTableName="user_cv"
                                 baseColumnNames="user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addUniqueConstraint tableName="user_cv"
                             columnNames="user_id"
                             constraintName="uc_user_cv_user_id"/>

        <createIndex tableName="user_cv" indexName="idx_user_cv_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20-drop-cv_file_id-column" author="codex">
        <dropIndex indexName="idx_users_cv_file_id" tableName="users"/>
        <dropColumn tableName="users" columnName="cv_file_id"/>
    </changeSet>

    <changeSet id="21-fix-user-jobs-unique-index-length" author="assistant">
        <!--
          On MySQL with utf8mb4, indexes are limited to 3072 bytes.
          The unique index on (user_id, job_url) breaks when job_url length exceeds limit.
          We keep column length (for full data) but constrain the indexed prefix to 512 chars,
          avoiding data loss while keeping uniqueness enforcement.
        -->
        <preConditions onFail="MARK_RAN" onError="HALT">
            <dbms type="mysql"/>
        </preConditions>

        <!-- Drop the existing unique index/constraint -->
        <sql>
            ALTER TABLE user_jobs DROP INDEX uc_user_jobs_user_url;
        </sql>
    </changeSet>

    <changeSet id="22-alter-user-jobs-job-url-length" author="assistant">
        <!--
          Expand job_url to handle long URLs while keeping index/unique constraints valid.
          TEXT breaks indexed columns in MySQL without prefix length, so we use a larger VARCHAR.
        -->
        <modifyDataType tableName="user_jobs"
                        columnName="job_url"
                        newDataType="VARCHAR(2048)"/>
        <!-- Recreate unique index with prefix length -->
        <sql>
            CREATE UNIQUE INDEX uc_user_jobs_user_url ON user_jobs (user_id, job_url(512));
        </sql>
    </changeSet>

    <changeSet id="23-create-engine-configuration" author="assistant">
        <createTable tableName="engine_configuration">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_engine_configuration"/>
            </column>
            <column name="engine_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="tier" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="model" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="engine_configuration"
                             columnNames="engine_type, tier"
                             constraintName="uc_engine_configuration_type_tier"/>
    </changeSet>

    <changeSet id="24-seed-engine-configuration" author="assistant">
        <insert tableName="engine_configuration">
            <column name="engine_type" value="GPT"/>
            <column name="tier" value="ECONOMY"/>
            <column name="model" value="gpt-4o-mini"/>
        </insert>
        <insert tableName="engine_configuration">
            <column name="engine_type" value="GPT"/>
            <column name="tier" value="PREMIUM"/>
            <column name="model" value="gpt-5.2"/>
        </insert>
        <insert tableName="engine_configuration">
            <column name="engine_type" value="GEMINI"/>
            <column name="tier" value="ECONOMY"/>
            <column name="model" value="gemini-2.5-flash"/>
        </insert>
        <insert tableName="engine_configuration">
            <column name="engine_type" value="GEMINI"/>
            <column name="tier" value="PREMIUM"/>
            <column name="model" value="gemini-2.5-pro"/>
        </insert>
        <insert tableName="engine_configuration">
            <column name="engine_type" value="SERP"/>
            <column name="tier" value="ECONOMY"/>
            <column name="model" value="google_jobs"/>
        </insert>
    </changeSet>

    <changeSet id="25-normalize-user-prompts-engine" author="assistant">
        <comment>Normalize legacy engine values to the new enum set GPT/GEMINI/SERP</comment>
        <sql>
            UPDATE user_prompts SET engine = 'GPT' WHERE UPPER(engine) LIKE 'GPT%';
        </sql>
        <sql>
            UPDATE user_prompts SET engine = 'GEMINI' WHERE UPPER(engine) LIKE 'GEMINI%';
        </sql>
        <sql>
            UPDATE user_prompts SET engine = 'SERP' WHERE UPPER(engine) LIKE 'SERP%';
        </sql>
    </changeSet>

    <changeSet id="26-add-engine-config-fk-to-user-prompts" author="assistant">
        <addColumn tableName="user_prompts">
            <column name="engine_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint
            constraintName="fk_user_prompts_engine_configuration"
            baseTableName="user_prompts"
            baseColumnNames="engine_id"
            referencedTableName="engine_configuration"
            referencedColumnNames="id"
            onDelete="SET NULL"/>
        <createIndex tableName="user_prompts" indexName="idx_user_prompts_engine_id">
            <column name="engine_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="27-drop-engine-column-from-user-prompts" author="assistant">
        <dropColumn tableName="user_prompts" columnName="engine"/>
        <rollback>
            <addColumn tableName="user_prompts">
                <column name="engine" type="VARCHAR(255)"/>
            </addColumn>
        </rollback>
    </changeSet>

    <changeSet id="28-drop-tier-column-and-rename-engine-type" author="assistant">
        <comment>Drop tier column from engine_configuration and rename engine_type to engine</comment>
        <!-- Drop the unique constraint that includes tier -->
        <dropUniqueConstraint tableName="engine_configuration" constraintName="uc_engine_configuration_type_tier"/>
        <!-- Drop tier column -->
        <dropColumn tableName="engine_configuration" columnName="tier"/>
        <!-- Rename engine_type to engine -->
        <renameColumn tableName="engine_configuration" oldColumnName="engine_type" newColumnName="engine" columnDataType="VARCHAR(255)"/>
    </changeSet>

</databaseChangeLog>
